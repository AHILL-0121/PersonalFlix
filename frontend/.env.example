# ─── Clerk ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
# Your Clerk user ID (user_…). Only these accounts get in — /api/token hands out a Drive read token.
ALLOWED_USER_IDS=user_REPLACE_ME

# ─── Google Drive (through the "PersonalFlix Read" Apps Script, see apps-script/) ──
# The web app's /exec URL and the PASSPHRASE script property you set on it
DRIVE_TOKEN_URL=https://script.google.com/macros/s/REPLACE_ME/exec
DRIVE_TOKEN_PASSPHRASE=REPLACE_ME
# File ID of STREAM/library.json — printed at the end of every convert-notebook run
LIBRARY_FILE_ID=REPLACE_ME

# ─── Upload page (/upload) ───────────────────────────────────────────────────
# The "PersonalFlix Write" Apps Script (drive scope) — the same one the notebook's WRITE_URL uses.
# Server-only: the browser never sees this token, only a one-file upload link.
DRIVE_WRITE_URL=https://script.google.com/macros/s/REPLACE_ME/exec
DRIVE_WRITE_PASSPHRASE=REPLACE_ME
# Optional: the folder holding MOVIE/, SERIES/ and STREAM/. Found from LIBRARY_FILE_ID when empty.
MEDIA_ROOT_FOLDER_ID=
# Optional: the convert notebook's Colab link, for the "Open notebook" button
COLAB_NOTEBOOK_URL=
# Optional: lets the notebook sync the library itself when a run ends (Colab secret SYNC_SECRET,
# notebook SYNC_URL = https://<your app>/api/library/refresh). At least 16 characters.
SYNC_SECRET=

# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ─── Artwork ─────────────────────────────────────────────────────────────────
TMDB_API_KEY=REPLACE_ME
# Optional fallback when TMDB has no match
OMDB_API_KEY=
