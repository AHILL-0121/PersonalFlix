// Catalog + watch progress. The playable files themselves live in Drive (STREAM/ folder); the
// convert notebook writes STREAM/library.json and POST /api/library/refresh copies it in here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TitleType {
  movie
  series
}

model Title {
  id            String    @id @default(uuid())
  // library.json title key: "MOVIE/Kaadan-2021" or "SERIES/Ben 10 - 2005"
  libraryKey    String?   @unique
  // legacy: Drive folder ID from the old folder scanner (kept so old rows still match)
  driveFolderId String?   @unique
  type          TitleType
  name          String
  posterUrl     String?

  // OMDb / TMDB / IMDb fields
  imdbId          String?
  tmdbId          Int?
  tmdbEpisodeSync Boolean @default(false)
  backdropUrl     String?
  overview        String?
  rating          Float?
  year            Int?

  seasons   Season[]
  episodes  Episode[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Season {
  id       String    @id @default(uuid())
  titleId  String
  number   Int
  title    Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodes Episode[]

  // OMDb / TMDB / IMDb fields
  imdbId    String?
  tmdbId    Int?
  posterUrl String?

  @@unique([titleId, number])
}

model Episode {
  id          String  @id @default(uuid())
  seasonId    String?
  titleId     String
  // library.json entry key: "MOVIE/Kaadan-2021" or "SERIES/Ben 10 - 2005/S01E05"
  libraryKey  String? @unique
  // Drive ID of the source video (mp4/mkv) the stream was made from
  driveFileId String  @unique
  name        String
  order       Int
  durationSec Int?

  // DASH manifest with Drive BaseURLs, straight from library.json; null = not converted yet
  mpd         String?
  // [{ lang, label }] in the manifest's audio order
  audio       Json?
  height      Int?
  convertedAt String?

  // OMDb / TMDB / IMDb fields
  imdbId       String?
  tmdbId       Int?
  thumbnailUrl String?
  overview     String?

  season        Season?        @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  title         Title          @relation(fields: [titleId], references: [id], onDelete: Cascade)
  watchProgress WatchProgress?

  @@index([titleId])
  @@index([seasonId])
}

model WatchProgress {
  episodeId   String   @id
  positionSec Float    @default(0)
  updatedAt   DateTime @updatedAt
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

// One row (id = 1): when library.json was last synced and what it said
model SyncState {
  id               Int      @id @default(1)
  syncedAt         DateTime @default(now())
  libraryUpdatedAt String?
  entries          Int      @default(0)
}
